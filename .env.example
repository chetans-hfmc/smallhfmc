# HFMC Case Tracker — environment
# 1) Create a project at https://supabase.com
# 2) Project Settings → API → copy the two values below
# 3) Save this file as .env.local in the project root and fill the values
#    (on Netlify: Site settings → Environment variables instead)
# Until these are set, the app runs fully on its local in-browser database.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
